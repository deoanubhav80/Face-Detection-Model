import cv2

# ---------------------------------------------------
# Load face detection model
# ---------------------------------------------------
face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades +
    "haarcascade_frontalface_default.xml"
)

# Pre-trained model to detect faces

# ---------------------------------------------------
# Open webcam
# ---------------------------------------------------
cap = cv2.VideoCapture(0)

while True:

    # Read frame from camera
    success, frame = cap.read()

    # Stop if camera fails
    if not success:
        break

    # ---------------------------------------------------
    # Convert image to gray
    # Faster for face detection
    # ---------------------------------------------------
    frame = cv2.flip(frame, 1)
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    # ---------------------------------------------------
    # Detect faces
    # ---------------------------------------------------
    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    # faces contains all detected faces

    # ---------------------------------------------------
    # Draw rectangle on each face
    # ---------------------------------------------------
    for (x, y, w, h) in faces:

        cv2.rectangle(
            frame,
            (x, y),
            (x + w, y + h),
            (255,0,0),   # blue box
            3
        )

    # ---------------------------------------------------
    # Show total face count
    # len(faces) = number of faces
    # ---------------------------------------------------
    cv2.putText(
        frame,
        "Faces: " + str(len(faces)),
        (10,30),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0,0,255),   # red text
        2
    )

    # ---------------------------------------------------
    # Show final output
    # ---------------------------------------------------
    cv2.imshow("Face Count AI", frame)

    # Press ESC to exit
    key = cv2.waitKey(1) & 0xFF

    if key == 27:
        break

# ---------------------------------------------------
# Close camera
# ---------------------------------------------------
cap.release()
cv2.destroyAllWindows()
